#
# ~/.bashrc
#

[[ $- != *i* ]] && return

# Aliases
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias brave='flatpak run com.brave.Browser'

# PURPLE CYBERPUNK PROMPT

# PURPLE CYBERPUNK - STARSHIP
eval "$(starship init bash)"




# Limpa a tela inteira, incluindo o Fastfetch
clear() {
    printf '\033[2J\033[3J\033[H'
}

# ARCH // INITIAL SCREEN
if [[ $- == *i* && $TERM == xterm-kitty ]]; then
    "$HOME/.config/kitty/arch-startup.sh"
fi

# CLEAR // FULL SCREEN
clear() {
    printf '\033[2J\033[3J\033[H'
}


# EZA - ícones de arquivos e pastas
unalias ls 2>/dev/null
alias ls='$HOME/.local/bin/ls-home-colorido'
alias ll='eza -la --icons=always --group-directories-first'
alias lt='eza --tree --level=2 --icons=always'

